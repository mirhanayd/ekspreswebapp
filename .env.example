# PostgreSQL Database Configuration (Local Development Only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_password
POSTGRES_DB=ekspres_db
POSTGRES_PORT=5432

# Connection string for applications and Drizzle ORM
DATABASE_URL=postgres://postgres:postgres_local_password@127.0.0.1:5432/ekspres_db

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Authentication (use a unique high-entropy value outside local development)
JWT_SECRET=local-development-only-secret-change-me

# API / web origins
PORT=3001
API_URL=http://127.0.0.1:3001/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1
WEB_ORIGIN=http://localhost:3000
WEB_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Live tracking
TRACKING_LATEST_TTL_SECONDS=120
TRACKING_HISTORY_INTERVAL_SECONDS=30

# Optional managed realtime publish key for the serverless migration.
# Keep this server-side only. Never expose it as NEXT_PUBLIC_*.
# ABLY_API_KEY=replace-me

# Optional demo tracking settings
SIMULATOR_START_PERCENT=18
# SIMULATOR_HEALTH_PORT=3004

# Optional S3-compatible object storage contract (Cloudflare R2, S3, etc.).
# Leave commented until an upload feature is enabled.
# OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=ekspres-production
# OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
# OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://assets.example.com

# Passenger and driver Vercel Node auth handlers both require DATABASE_URL and JWT_SECRET.
# Configure these server-side in each project's Preview/Production scope.
# Passenger non-auth and admin APIs still use API_URL during issue #73.
